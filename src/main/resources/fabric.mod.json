{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "https://yourwebsite.com/"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/logo.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.example.examplemod.ExampleModDataGeneration"
    ],
    "main": [
      "com.example.examplemod.ExampleMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "farmersdelight": "*",
    "delightlib": "*"
  }
}